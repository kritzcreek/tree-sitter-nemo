{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "nemo",
      "camelcase": "Nemo",
      "title": "Nemo",
      "scope": "source.nemo",
      "file-types": [
        "nemo"
      ],
      "injection-regex": "^nemo$",
      "class-name": "TreeSitterNemo"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Nemo grammar for tree-sitter",
    "authors": [
      {
        "name": "Christoph Hegemann",
        "email": "christoph.hegemann1337@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/kritzcreek/tree-sitter-nemo"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}